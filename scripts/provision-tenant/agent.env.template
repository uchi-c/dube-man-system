# pc-agent env — one .env per PC. Copy to pc-agent/.env on each machine.
# Every value below must belong to THIS tenant's Supabase project.

SUPABASE_URL=https://<tenant-project-ref>.supabase.co
SUPABASE_ANON_KEY=<tenant-anon-or-publishable-key>

# Unique per machine. This is how the workstation shows up in the console
# and how remote commands (LOCK/UNLOCK/…) are routed. e.g. PC-01, PC-02.
COMPUTER_CODE=PC-01

# Heartbeat cadence in seconds.
HEARTBEAT_INTERVAL=30

# Per-tenant shared secret for the agent. NOT self-generated -- since
# migration 012, every agent request is checked against the one secret
# Postgres already generated and stored on this tenant's organizations row.
# Get it from PC Agent Hub > "Agent secret" in the app (admin only), or use
# pc-agent/remote-install.ps1 with a provisioning code, which fetches it
# automatically.
AGENT_SECRET=<get-this-tenants-real-secret-from-the-app>
