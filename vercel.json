{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/.env(.*)", "destination": "/", "statusCode": 404 },
    { "source": "/.git(/.*)?", "destination": "/", "statusCode": 404 },
    { "source": "/.aws(/.*)?", "destination": "/", "statusCode": 404 },
    { "source": "/.DS_Store", "destination": "/", "statusCode": 404 },
    { "source": "/.htpasswd", "destination": "/", "statusCode": 404 },
    { "source": "/wp-config.php.bak", "destination": "/", "statusCode": 404 },
    { "source": "/wp-config.php~", "destination": "/", "statusCode": 404 },
    { "source": "/config.php.bak", "destination": "/", "statusCode": 404 },
    { "source": "/backup.zip", "destination": "/", "statusCode": 404 },
    { "source": "/server-status", "destination": "/", "statusCode": 404 },
    { "source": "/phpinfo.php", "destination": "/", "statusCode": 404 },
    { "source": "/id_rsa", "destination": "/", "statusCode": 404 },
    { "source": "/debug", "destination": "/", "statusCode": 404 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
